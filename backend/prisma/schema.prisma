generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  description String
  variants    Variant[]
  emiPlans    EmiPlan[]
}

model Variant {
  id        String  @id @default(uuid())
  productId String
  color     String
  storage   String
  mrp       Int
  price     Int
  imageUrl  String
  product   Product @relation(fields: [productId], references: [id])
}

model EmiPlan {
  id            String  @id @default(uuid())
  productId     String
  monthlyAmount Int
  tenureMonths  Int
  interestRate  Float
  cashbackInfo  String?
  product       Product @relation(fields: [productId], references: [id])
}
